# AlphaRL-Quant Backup Configuration
# Copy this to .backup.env and customize

# =============================================================================
# Backup Directories
# =============================================================================
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=7

# =============================================================================
# Components to Backup
# =============================================================================
BACKUP_DATABASE=true
BACKUP_MODELS=true
BACKUP_CONFIG=true
BACKUP_LOGS=false

# =============================================================================
# Cloud Upload (AWS S3)
# =============================================================================
UPLOAD_TO_S3=false
AWS_S3_BUCKET=my-alpharl-backups
AWS_REGION=us-east-1

# Credentials (leave empty to use AWS CLI default profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Cloud Upload (Google Cloud Storage)
# =============================================================================
UPLOAD_TO_GCS=false
GCP_BUCKET=my-alpharl-backups
GCP_PROJECT_ID=

# Credentials (leave empty to use gcloud default)
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Notification Settings (future enhancement)
# =============================================================================
NOTIFY_ON_SUCCESS=false
NOTIFY_ON_FAILURE=true
NOTIFICATION_EMAIL=admin@example.com
SLACK_WEBHOOK_URL=

# =============================================================================
# Advanced Settings
# =============================================================================
COMPRESSION_LEVEL=6  # 1-9, higher = better compression but slower
PARALLEL_UPLOADS=false  # Upload to S3 and GCS in parallel
ENCRYPT_BACKUPS=false  # Encrypt with GPG before upload
GPG_RECIPIENT=
